{
  "name": "spa",
  "version": "1.0.0",
  "description": "Local-first CLI that turns bank exports into an honest answer to where it all went.",
  "keywords": [
    "cli",
    "personal-finance",
    "budgeting",
    "csv",
    "transactions",
    "categorisation",
    "viseca",
    "zkb",
    "wise",
    "revolut"
  ],
  "homepage": "https://github.com/patforna/spa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patforna/spa.git"
  },
  "bugs": {
    "url": "https://github.com/patforna/spa/issues"
  },
  "license": "MIT",
  "author": "Patric Fornasier",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "bin": {
    "spa": "bin/spa"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --silent",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sort-rules": "node scripts/sort-rules.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "currency.js": "^2.0.4",
    "dayjs": "^1.11.19",
    "glob": "^13.0.0",
    "inquirer": "^9.1.4",
    "inquirer-autocomplete-prompt": "^3.0.0",
    "js-levenshtein": "^1.1.6",
    "json-stringify-pretty-compact": "^4.0.0",
    "lodash": "^4.17.21",
    "papaparse": "^5.5.3",
    "table": "^6.8.1",
    "yargs": "^17.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.3",
    "@swc/jest": "^0.2.39",
    "@types/inquirer": "^9.0.3",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.14.202",
    "@types/node": "^24.10.1",
    "@types/table": "^6.0.0",
    "@types/yargs": "^17.0.32",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jest": "^29.7.0",
    "prettier": "^3.7.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.68.0"
  }
}
