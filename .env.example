# Exchange rates for foreign-currency transactions (Wise, Revolut).
# Only needed for dates that are not already in <data-dir>/fxRates.json.
# Free key: https://fixer.io
FIXER_API_KEY=

# Where rules, overrides and the FX cache live. Defaults to ./data.
# Point this at a directory outside the repo to keep your data private.
# SPA_DATA_DIR=~/my-finances/spa-data
